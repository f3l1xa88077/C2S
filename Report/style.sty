% -----------------------
% Heading Formatting 
% -----------------------

\newlength{\numberwidth}
\setlength{\numberwidth}{2em} % horizontal position of all numbers

% Section
\titleformat{\section}[hang]
  {\normalfont\Large\bfseries}  % formatting
  {\llap{\thesection\hspace{1.5em}}}  % number flush left
  {0pt}                          % no extra space between number and text
  {}

% Subsection
\titleformat{\subsection}[hang]
  {\normalfont\large\bfseries}
  {\llap{\thesubsection\hspace{1.5em}}}
  {0pt}
  {\hspace{2em}} % optional indentation for subsection text

% Subsubsection
\titleformat{\subsubsection}[hang]
  {\normalfont\normalsize\bfseries}
  {\llap{\thesubsubsection\hspace{1.5em}}}
  {0pt}
  {\hspace{3.5em}} % optional indentation for subsubsection text


% -----------------------
% Further Heading Depth
% -----------------------

% 1. Define the new level and its counter
\titleclass{\subsubsubsection}{straight}[\subsubsection]
\newcounter{subsubsubsection}[subsubsection]
\renewcommand\thesubsubsubsection{\thesubsubsection.\arabic{subsubsubsection}}

% 2. Apply your custom style to match sections/subsections
\titleformat{\subsubsubsection}[hang]
  {\normalfont\normalsize\bfseries\subsubsubsectionindent} % Trigger indent here
  {\llap{\thesubsubsubsection\hspace{5.5em}}}
  {0pt}
  {\hspace{-0.5em}}

\titlespacing*{\subsubsubsection}
  {0pt}
  {3.25ex plus 1ex minus .2ex}
  {1.5ex plus .2ex}

% 3. Update depth counters so the new level is numbered and in TOC
\setcounter{secnumdepth}{4} 
\setcounter{tocdepth}{4}

% 4. Fix paragraph/subparagraph inheritance (Optional)
% This ensures level 5 (paragraph) numbers correctly if you use them
\makeatletter
\renewcommand\theparagraph{\thesubsubsubsection.\arabic{paragraph}}
\makeatother

% 1. Define the name for \autoref
\newcommand{\subsubsubsectionautorefname}{Section} 
% Or use "Sub-sub-subsection" if you prefer

% 2. Link the counter to the name (required for custom levels)
\makeatletter
\newcommand{\toclevel@subsubsubsection}{4} % Tells hyperref this is level 4
\makeatother


% -----------------------
% Indentation Helpers
% -----------------------
\newcommand{\sectionindent}{\setlength{\leftskip}{2em}}
\newcommand{\subsectionindent}{\setlength{\leftskip}{3em}}
\newcommand{\subsubsectionindent}{\setlength{\leftskip}{4em}}
\newcommand{\subsubsubsectionindent}{\setlength{\leftskip}{5em}}
\newcommand{\resetindent}{\setlength{\leftskip}{0pt}}

% Track current heading level
\newcounter{headinglevel}
\setcounter{headinglevel}{1} % default: section

% Hook into headings
\preto\section{\resetindent\setcounter{headinglevel}{1}}
\preto\subsection{\subsectionindent\setcounter{headinglevel}{2}}
\preto\subsubsection{\subsubsectionindent\setcounter{headinglevel}{3}}
\preto\subsubsubsection{\subsubsubsectionindent\setcounter{headinglevel}{4}}

% -----------------------
% Figures and Tables that follow indentation
% -----------------------
\RequirePackage{changepage} % ensure adjustwidth is loaded
\RequirePackage{float}      % for [H] placement

\newenvironment{indentedfigure}
{%
    \begin{figure}[H]
    \ifnum\value{headinglevel}=1
        \begin{adjustwidth}{0pt}{0pt}%
    \else\ifnum\value{headinglevel}=2
        \begin{adjustwidth}{2em}{0pt}%
    \else\ifnum\value{headinglevel}=3
        \begin{adjustwidth}{4em}{0pt}%
    \else\ifnum\value{headinglevel}=4
        \begin{adjustwidth}{6em}{0pt}% <-- Level 4
    \else
        \begin{adjustwidth}{0pt}{0pt}% Fallback
    \fi\fi\fi\fi
    \centering 
}
{%
    \end{adjustwidth}
    \end{figure}
}

\newenvironment{indentedtable}
{%
    \begin{table}[H]
    \ifnum\value{headinglevel}=1
        \begin{adjustwidth}{0pt}{0pt}%
    \else\ifnum\value{headinglevel}=2
        \begin{adjustwidth}{2em}{0pt}%
    \else\ifnum\value{headinglevel}=3
        \begin{adjustwidth}{4em}{0pt}%
    \else\ifnum\value{headinglevel}=4
        \begin{adjustwidth}{6em}{0pt}% <-- Level 4
    \else
        \begin{adjustwidth}{0pt}{0pt}% Fallback
    \fi\fi\fi\fi
    \centering 
}
{%
    \end{adjustwidth}
    \end{table}
}



